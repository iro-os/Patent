# ── Supabase (created during Phase 0; fill once the project exists) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon or sb_publishable_... key
SUPABASE_SERVICE_ROLE_KEY=            # server-only; never expose to the browser

# ── Claude (LLM) — zero-retention account ──
ANTHROPIC_API_KEY=
# Cost control: Sonnet for dev/testing, Opus for production-quality drafting.
PATENT_AI_MODEL=claude-sonnet-4-6     # swap to claude-opus-4-8 for production runs

# ── Embeddings (multilingual, zero-retention) ──
EMBEDDINGS_PROVIDER=voyage            # voyage|cohere|openai
EMBEDDINGS_API_KEY=
# vector dim must match supabase/migrations/0001_init.sql (1024 for voyage/cohere)

# ── Prior-art search (free/low-cost first) ──
SERPAPI_API_KEY=                      # Google Patents (free tier ~100/mo); paid scale post-Monday
PUBMED_API_KEY=                       # optional; raises E-utilities rate limit (free)
# OpenAlex needs no key (free). KIPRIS/EPO added in Phase 3.

# ── Deep-research cost guardrails (dev/testing) ──
DEEP_RESEARCH_MAX_SEARCHES=20
DEEP_RESEARCH_MAX_LLM_CALLS=15
