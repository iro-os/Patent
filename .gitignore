# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# KIPO 예시/서식 원본 PDF (바이너리) — 공개 문서라 언제든 재취득 가능, git 비대화 방지로 제외.
# 가치 있는 파생물(lib/exemplars/data/*.json, docs/exemplars/*.md)은 커밋한다.
resource/exemplars/pdf/
resource/특허 제출 자료 예시/
resource/특허 제출 자료 서식/

# 야간 자율 개선 루프 스크래치(백로그/진행 로그). 결과물(코드/docs/)은 별도 커밋, 작업 메모만 제외.
